{
  "name": "portfolio-sketchbook",
  "version": "0.1.0",
  "private": true,
  "description": "A page-flipping portfolio sketchbook — production Next.js rebuild inspired by MengTo/sketchbook",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run typecheck && npm run check:assets",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3"
  }
}